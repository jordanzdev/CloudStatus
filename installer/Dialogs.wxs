<?xml version="1.0" encoding="utf-8"?>
<!--
  Installer pages. Every text is a property (Texts.wxs) holding English by default; choosing
  Español on the first page swaps them before the next page is created, so the rest of the
  installer follows the chosen language.

  Flow: Install (language and options) -> Progress -> Done, plus the pages Windows Installer
  needs for cancellation, errors and applications in use. Sizes are in dialog units
  (370 x 270, like WixUI).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <!-- Generated by tools/New-Branding.ps1 -->
    <Binary Id="BannerBitmap" SourceFile="$(sys.SOURCEFILEDIR)..\assets\installer-banner.bmp" />
    <Binary Id="SideBitmap" SourceFile="$(sys.SOURCEFILEDIR)..\assets\installer-side.bmp" />

    <!--
      Preselected language: CloudStatus's own setting if it has one, otherwise Spanish when the
      user's Windows language is a Spanish variant, otherwise English.
    -->
    <Property Id="CLOUDSTATUS_APPLANGUAGE">
      <RegistrySearch Id="AppLanguageSearch" Root="HKCU" Key="Software\CloudStatus" Name="Language" Type="raw" />
    </Property>
    <Property Id="CLOUDSTATUS_LANGUAGE" Value="en" />
    <!-- "|3082|" etc., so one "contains" test (><) covers every Spanish language id. -->
    <SetProperty Id="UserLanguageKey" Action="SetUserLanguageKey" Value="|[UserLanguageID]|" Sequence="ui" After="AppSearch" />
    <SetProperty Id="CLOUDSTATUS_LANGUAGE" Value="es" Sequence="ui" After="SetUserLanguageKey"
                 Condition="CLOUDSTATUS_APPLANGUAGE = &quot;#1&quot; OR (CLOUDSTATUS_APPLANGUAGE &lt;&gt; &quot;#2&quot; AND &quot;|1034|3082|2058|4106|5130|6154|7178|8202|9226|10250|11274|12298|13322|14346|15370|16394|17418|18442|19466|20490|21514|22538|&quot; &gt;&lt; UserLanguageKey)" />

    <!-- Last page: "Create a desktop shortcut" starts unchecked and is hidden if one already exists. -->
    <Property Id="DESKTOPLINKEXISTS">
      <DirectorySearch Id="DesktopSearch" Path="[DesktopFolder]" Depth="0">
        <FileSearch Id="DesktopLinkSearch" Name="CloudStatus.lnk" />
      </DirectorySearch>
    </Property>

    <Property Id="OPENAPP" Value="1" />
    <Property Id="RMOPTION" Value="UseRM" />
    <Property Id="ErrorDialog" Value="ErrorDlg" />
    <Property Id="DefaultUIFont" Value="NormalFont" />

    <UI Id="CloudStatusDialogs">
      <UIRef Id="CloudStatusTexts" />

      <TextStyle Id="NormalFont" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="TitleFont" FaceName="Segoe UI" Size="13" />

      <!--
        1. Install: language and options. The page switches language as soon as a radio button
        is picked: each text and button exists once per language in the same place, and Windows
        Installer re-evaluates the Show/Hide/Default conditions whenever CLOUDSTATUS_LANGUAGE changes.
      -->
      <Dialog Id="LanguageDlg" Width="370" Height="270" Title="CloudStatus">
        <Control Id="Side" Type="Bitmap" X="0" Y="0" Width="123" Height="234" Text="SideBitmap" TabSkip="no" />

        <Control Id="TitleEn" Type="Text" X="138" Y="20" Width="220" Height="22" NoPrefix="yes"
                 Text="{\TitleFont}Install CloudStatus" ShowCondition="CLOUDSTATUS_LANGUAGE = &quot;en&quot;" HideCondition="CLOUDSTATUS_LANGUAGE &lt;&gt; &quot;en&quot;" />
        <Control Id="TitleEs" Type="Text" X="138" Y="20" Width="220" Height="22" NoPrefix="yes"
                 Text="{\TitleFont}Instalar CloudStatus" ShowCondition="CLOUDSTATUS_LANGUAGE = &quot;es&quot;" HideCondition="CLOUDSTATUS_LANGUAGE &lt;&gt; &quot;es&quot;" />
        <Control Id="PromptEn" Type="Text" X="138" Y="50" Width="220" Height="44" NoPrefix="yes"
                 Text="Choose the language of the installer and of CloudStatus. You can change it later in CloudStatus's settings."
                 ShowCondition="CLOUDSTATUS_LANGUAGE = &quot;en&quot;" HideCondition="CLOUDSTATUS_LANGUAGE &lt;&gt; &quot;en&quot;" />
        <Control Id="PromptEs" Type="Text" X="138" Y="50" Width="220" Height="44" NoPrefix="yes"
                 Text="Elige el idioma del instalador y de CloudStatus. Podrás cambiarlo más adelante en los ajustes de CloudStatus."
                 ShowCondition="CLOUDSTATUS_LANGUAGE = &quot;es&quot;" HideCondition="CLOUDSTATUS_LANGUAGE &lt;&gt; &quot;es&quot;" />

        <Control Id="Choice" Type="RadioButtonGroup" X="138" Y="104" Width="200" Height="44" Property="CLOUDSTATUS_LANGUAGE">
          <RadioButtonGroup Property="CLOUDSTATUS_LANGUAGE">
            <RadioButton Value="en" X="0" Y="0" Width="200" Height="16" Text="English" />
            <RadioButton Value="es" X="0" Y="22" Width="200" Height="16" Text="Español" />
          </RadioButtonGroup>
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="InstallEn" Type="PushButton" X="210" Y="243" Width="72" Height="17" Default="yes" Text="Install"
                 ShowCondition="CLOUDSTATUS_LANGUAGE = &quot;en&quot;" HideCondition="CLOUDSTATUS_LANGUAGE &lt;&gt; &quot;en&quot;" DefaultCondition="CLOUDSTATUS_LANGUAGE = &quot;en&quot;">
          <Publish Property="CLOUDSTATUS_SETLANGUAGE" Value="1" Order="1" />
          <Publish Property="CLOUDSTATUS_LANGUAGEID" Value="2" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="100" />
        </Control>
        <Control Id="InstallEs" Type="PushButton" X="210" Y="243" Width="72" Height="17" Text="Instalar"
                 ShowCondition="CLOUDSTATUS_LANGUAGE = &quot;es&quot;" HideCondition="CLOUDSTATUS_LANGUAGE &lt;&gt; &quot;es&quot;" DefaultCondition="CLOUDSTATUS_LANGUAGE = &quot;es&quot;">
          <!-- Texts.wxs also sets the Spanish texts here, before EndDialog. -->
          <Publish Property="CLOUDSTATUS_SETLANGUAGE" Value="1" Order="1" />
          <Publish Property="CLOUDSTATUS_LANGUAGEID" Value="1" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="100" />
        </Control>
        <Control Id="CancelEn" Type="PushButton" X="288" Y="243" Width="72" Height="17" Cancel="yes" Text="Cancel"
                 ShowCondition="CLOUDSTATUS_LANGUAGE = &quot;en&quot;" HideCondition="CLOUDSTATUS_LANGUAGE &lt;&gt; &quot;en&quot;">
          <Publish Event="EndDialog" Value="Exit" Order="100" />
        </Control>
        <Control Id="CancelEs" Type="PushButton" X="288" Y="243" Width="72" Height="17" Text="Cancelar"
                 ShowCondition="CLOUDSTATUS_LANGUAGE = &quot;es&quot;" HideCondition="CLOUDSTATUS_LANGUAGE &lt;&gt; &quot;es&quot;">
          <!-- Texts.wxs sets the Spanish "cancelled" texts here, before EndDialog. -->
          <Publish Event="EndDialog" Value="Exit" Order="100" />
        </Control>
      </Dialog>

      <!-- 2. Progress -->
      <Dialog Id="ProgressDlg" Width="370" Height="270" Title="CloudStatus" Modeless="yes">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Text="BannerBitmap" TabSkip="no" />
        <Control Id="Title" Type="Text" X="15" Y="12" Width="280" Height="22" Transparent="yes" NoPrefix="yes"
                 Text="{\TitleFont}[TxtProgressTitle]" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Description" Type="Text" X="20" Y="65" Width="330" Height="20" NoPrefix="yes"
                 Text="[TxtProgressText]" />
        <Control Id="Progress" Type="ProgressBar" X="20" Y="95" Width="330" Height="10" ProgressBlocks="yes" Text="Progress">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Cancel" Type="PushButton" X="288" Y="243" Width="72" Height="17" Default="yes" Cancel="yes"
                 Text="[TxtCancel]">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <!-- 3. Done, with "Create a desktop shortcut" (unchecked) and "Open CloudStatus" (checked) -->
      <Dialog Id="ExitDlg" Width="370" Height="270" Title="CloudStatus">
        <Control Id="Side" Type="Bitmap" X="0" Y="0" Width="123" Height="234" Text="SideBitmap" TabSkip="no" />
        <Control Id="Title" Type="Text" X="138" Y="20" Width="220" Height="40" NoPrefix="yes"
                 Text="{\TitleFont}[TxtExitTitle]" />
        <Control Id="Description" Type="Text" X="138" Y="66" Width="220" Height="60" NoPrefix="yes"
                 Text="[TxtExitText]" />
        <Control Id="DesktopShortcut" Type="CheckBox" X="138" Y="178" Width="220" Height="17" Property="DESKTOPSHORTCUT"
                 CheckBoxValue="1" Text="[TxtDesktopShortcut]" HideCondition="Installed OR DESKTOPLINKEXISTS" />
        <Control Id="OpenApp" Type="CheckBox" X="138" Y="200" Width="220" Height="17" Property="OPENAPP"
                 CheckBoxValue="1" Text="[TxtOpenApp]" HideCondition="Installed" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="288" Y="243" Width="72" Height="17" Default="yes" Cancel="yes"
                 Text="[TxtFinish]">
          <Publish Event="DoAction" Value="CreateDesktopShortcut" Order="1"
                   Condition="DESKTOPSHORTCUT = 1 AND NOT Installed AND NOT DESKTOPLINKEXISTS" />
          <Publish Event="DoAction" Value="LaunchApp" Order="2" Condition="OPENAPP = 1 AND NOT Installed" />
          <Publish Event="EndDialog" Value="Return" Order="100" />
        </Control>
      </Dialog>

      <!-- Cancelled by the user -->
      <Dialog Id="UserExitDlg" Width="370" Height="270" Title="CloudStatus">
        <Control Id="Side" Type="Bitmap" X="0" Y="0" Width="123" Height="234" Text="SideBitmap" TabSkip="no" />
        <Control Id="Title" Type="Text" X="138" Y="20" Width="220" Height="40" NoPrefix="yes"
                 Text="{\TitleFont}[TxtCancelledTitle]" />
        <Control Id="Description" Type="Text" X="138" Y="66" Width="220" Height="60" NoPrefix="yes"
                 Text="[TxtCancelledText]" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="288" Y="243" Width="72" Height="17" Default="yes" Cancel="yes"
                 Text="[TxtFinish]">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <!-- Failed -->
      <Dialog Id="FatalErrorDlg" Width="370" Height="270" Title="CloudStatus">
        <Control Id="Side" Type="Bitmap" X="0" Y="0" Width="123" Height="234" Text="SideBitmap" TabSkip="no" />
        <Control Id="Title" Type="Text" X="138" Y="20" Width="220" Height="40" NoPrefix="yes"
                 Text="{\TitleFont}[TxtFailedTitle]" />
        <Control Id="Description" Type="Text" X="138" Y="66" Width="220" Height="60" NoPrefix="yes"
                 Text="[TxtFailedText]" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="288" Y="243" Width="72" Height="17" Default="yes" Cancel="yes"
                 Text="[TxtFinish]">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <!-- Windows Installer error messages: it shows the buttons each message needs. -->
      <Dialog Id="ErrorDlg" Width="270" Height="105" Title="CloudStatus" ErrorDialog="yes">
        <Control Id="ErrorText" Type="Text" X="15" Y="15" Width="240" Height="60" NoPrefix="yes" TabSkip="no" />
        <Control Id="Y" Type="PushButton" X="100" Y="80" Width="72" Height="17" TabSkip="yes" Text="[TxtYes]">
          <Publish Event="EndDialog" Value="ErrorYes" />
        </Control>
        <Control Id="N" Type="PushButton" X="100" Y="80" Width="72" Height="17" TabSkip="yes" Text="[TxtNo]">
          <Publish Event="EndDialog" Value="ErrorNo" />
        </Control>
        <Control Id="O" Type="PushButton" X="100" Y="80" Width="72" Height="17" TabSkip="yes" Text="[TxtOk]">
          <Publish Event="EndDialog" Value="ErrorOk" />
        </Control>
        <Control Id="C" Type="PushButton" X="100" Y="80" Width="72" Height="17" TabSkip="yes" Text="[TxtCancel]">
          <Publish Event="EndDialog" Value="ErrorCancel" />
        </Control>
        <Control Id="A" Type="PushButton" X="100" Y="80" Width="72" Height="17" TabSkip="yes" Text="[TxtAbort]">
          <Publish Event="EndDialog" Value="ErrorAbort" />
        </Control>
        <Control Id="R" Type="PushButton" X="100" Y="80" Width="72" Height="17" TabSkip="yes" Text="[TxtRetry]">
          <Publish Event="EndDialog" Value="ErrorRetry" />
        </Control>
        <Control Id="I" Type="PushButton" X="100" Y="80" Width="72" Height="17" TabSkip="yes" Text="[TxtIgnore]">
          <Publish Event="EndDialog" Value="ErrorIgnore" />
        </Control>
      </Dialog>

      <!-- CloudStatus (or another app) is using the files: close it through the Restart Manager. -->
      <Dialog Id="MsiRMFilesInUse" Width="370" Height="270" Title="CloudStatus" KeepModeless="yes">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Text="BannerBitmap" TabSkip="no" />
        <Control Id="Title" Type="Text" X="15" Y="12" Width="280" Height="22" Transparent="yes" NoPrefix="yes"
                 Text="{\TitleFont}[TxtInUseTitle]" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="330" Height="20" NoPrefix="yes" Text="[TxtInUseText]" />
        <Control Id="List" Type="ListBox" X="20" Y="80" Width="330" Height="90" Property="FileInUseProcess"
                 Sunken="yes" TabSkip="yes" />
        <Control Id="Options" Type="RadioButtonGroup" X="20" Y="180" Width="330" Height="40" Property="RMOPTION">
          <RadioButtonGroup Property="RMOPTION">
            <RadioButton Value="UseRM" X="0" Y="0" Width="330" Height="16" Text="[TxtInUseClose]" />
            <RadioButton Value="DontUseRM" X="0" Y="20" Width="330" Height="16" Text="[TxtInUseKeep]" />
          </RadioButtonGroup>
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="OK" Type="PushButton" X="210" Y="243" Width="72" Height="17" Default="yes" Text="[TxtOk]">
          <Publish Event="RMShutdownAndRestart" Value="0" Condition="RMOPTION ~= &quot;UseRM&quot;" />
          <Publish Event="EndDialog" Value="Return" Order="100" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="288" Y="243" Width="72" Height="17" Cancel="yes" Text="[TxtCancel]">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <!-- Older files-in-use page, used when the Restart Manager is not available. -->
      <Dialog Id="FilesInUse" Width="370" Height="270" Title="CloudStatus" KeepModeless="yes">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Text="BannerBitmap" TabSkip="no" />
        <Control Id="Title" Type="Text" X="15" Y="12" Width="280" Height="22" Transparent="yes" NoPrefix="yes"
                 Text="{\TitleFont}[TxtInUseTitle]" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="330" Height="20" NoPrefix="yes" Text="[TxtInUseRetryText]" />
        <Control Id="List" Type="ListBox" X="20" Y="80" Width="330" Height="130" Property="FileInUseProcess"
                 Sunken="yes" TabSkip="yes" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Retry" Type="PushButton" X="132" Y="243" Width="72" Height="17" Default="yes" Text="[TxtRetry]">
          <Publish Event="EndDialog" Value="Retry" />
        </Control>
        <Control Id="Ignore" Type="PushButton" X="210" Y="243" Width="72" Height="17" Text="[TxtIgnore]">
          <Publish Event="EndDialog" Value="Ignore" />
        </Control>
        <Control Id="Exit" Type="PushButton" X="288" Y="243" Width="72" Height="17" Cancel="yes" Text="[TxtExit]">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="LanguageDlg" Before="ProgressDlg" Condition="NOT Installed" />
        <Show Dialog="ProgressDlg" Before="ExecuteAction" />
        <Show Dialog="ExitDlg" OnExit="success" />
        <Show Dialog="UserExitDlg" OnExit="cancel" />
        <Show Dialog="FatalErrorDlg" OnExit="error" />
      </InstallUISequence>

      <!-- Administrative installs (msiexec /a) need the same end pages (ICE20). -->
      <AdminUISequence>
        <Show Dialog="ProgressDlg" Before="ExecuteAction" />
        <Show Dialog="ExitDlg" OnExit="success" />
        <Show Dialog="UserExitDlg" OnExit="cancel" />
        <Show Dialog="FatalErrorDlg" OnExit="error" />
      </AdminUISequence>
    </UI>
  </Fragment>
</Wix>
