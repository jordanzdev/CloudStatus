<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>CloudStatus</AssemblyName>
    <RootNamespace>CloudStatus</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated by tools/New-Branding.ps1 -->
    <ApplicationIcon>..\assets\CloudStatus.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>CloudStatus</Product>
    <Authors>jordanzdev</Authors>
    <Company>jordanzdev</Company>
    <Copyright>Copyright (c) 2026 jordanzdev</Copyright>
  </PropertyGroup>

  <!-- NativeAOT: a single native exe, no JIT, as small as possible. -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <!-- Workstation GC without a background GC thread: fewer threads and less memory. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
